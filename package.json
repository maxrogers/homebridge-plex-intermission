{
  "name": "homebridge-plex-intermission",
  "displayName": "Intermission for Plex",
  "type": "module",
  "version": "1.0.1",
  "description": "Apple Home sensors for every moment of Plex playback: playing, paused, credits and nothing playing. Timed to Plex's credits markers, instant without polling.",
  "author": "maxrogers",
  "license": "MIT",
  "homepage": "https://github.com/maxrogers/homebridge-plex-intermission#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maxrogers/homebridge-plex-intermission.git"
  },
  "bugs": {
    "url": "https://github.com/maxrogers/homebridge-plex-intermission/issues"
  },
  "funding": {
    "type": "ko-fi",
    "url": "https://ko-fi.com/maxrogers"
  },
  "keywords": [
    "homebridge-plugin",
    "supports-hap",
    "homebridge",
    "homekit",
    "plex",
    "plex webhooks",
    "credits",
    "movie night",
    "home theater",
    "lighting"
  ],
  "main": "dist/index.js",
  "engines": {
    "node": "^22.10.0 || ^24.0.0 || ^26.0.0",
    "homebridge": "^2.0.0"
  },
  "files": [
    "dist",
    "homebridge-ui",
    "config.schema.json",
    "icon.png",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rimraf ./dist && tsc",
    "lint": "eslint . --max-warnings=0",
    "test": "npm run build && node --test test/*.test.js",
    "prepublishOnly": "npm run lint && npm run build"
  },
  "dependencies": {
    "@homebridge/plugin-ui-utils": "^2.2.6",
    "qrcode-generator": "2.0.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.9.0",
    "globals": "^17.13.0",
    "homebridge": "^2.4.0",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.0"
  }
